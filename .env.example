# Copy to .env.local. Fill in your own credentials locally; never commit them.
# Finished demo configuration: remote brain, local speech and avatar processing.
LLM_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=

# Optional remote semantic guard. With an empty key it is disabled.
TYPESAFE_API_KEY=
TYPESAFE_PROXY=

# Set to 1 only if you intentionally need the LLM API to use your system proxy.
# LLM_VIA_PROXY=1
